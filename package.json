{
  "name": "alpahaar-menu-builder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "create-user": "node --env-file=.env.local scripts/create-user.mjs",
    "db:start": "npx supabase start",
    "db:cred": "npx supabase status -o env",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset --debug",
    "db:status": "npx supabase status",
    "db:pull": "npx supabase db pull --linked",
    "db:dump": "npx supabase db dump --linked --data-only --schema public,auth,storage --exclude public.taxonomy_terms --exclude storage.buckets --exclude storage.objects -f supabase/seed.sql",
    "db:list": "npx supabase migration list",
    "db:new": "npx supabase migration new",
    "db:diff": "npx supabase db diff",
    "db:types": "npx supabase gen types typescript --local > src/auth/database.types.ts",
    "db:studio": "npx supabase studio"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^15.5.27",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
