# ─────────────────────────────────────────────────────────────
# Alpahaar Foods – environment variables
# Copy this file to .env.local for local dev.
# On Render: add the same keys under Environment (see render.yaml).
# NEVER commit real keys. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Only used by `npm run create-user` (never by the running app).
SUPABASE_SERVICE_ROLE_KEY=

# ── Access control ───────────────────────────────────────────
# Comma-separated list of emails allowed to use the app and spend AI credits.
# Leave empty to allow any signed-in Supabase user.
ALLOWED_EMAILS=

# ── AI message writer (server-side only) ─────────────────────
# Which provider is pre-selected for new users: openai | claude | gemini
DEFAULT_AI_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── ElevenLabs text-to-speech (server-side only) ─────────────
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4
# Audio tag put in front of every read-out (v3/v4 models only). Empty = none.
# Examples: [warm]  [cheerful]  [calm]
ELEVENLABS_STYLE_TAG=[warm]
# Voice IDs from elevenlabs.io → Voices → (voice) → "ID".
# Any voice you leave empty falls back to ELEVENLABS_VOICE_KAVITA.
ELEVENLABS_VOICE_KAVITA=iPmVSMDLX3FRQaONHDW2 # Instant voice clone of Kavita's voice
ELEVENLABS_VOICE_SUNITA=AiJ5mX6DkaITZYbWMUlR # Instant voice clone of Sunita's voice (optional)
# Instant voice clone of Maa's voice (optional)
ELEVENLABS_VOICE_MAA=
